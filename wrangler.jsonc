{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "admin",
        "name": "AI"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "flytrip_db"
      ],
      "tag": "v1"
    }
  ]
}
